generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  expenses     Expense[]
  incomes      Income[]
  investments  Investment[]
  chatMessages ChatMessage[]
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  category    String
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Income {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  source      String
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Investment {
  id            String   @id @default(cuid())
  userId        String
  name          String
  type          String
  initialAmount Float
  currentValue  Float
  date          DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
